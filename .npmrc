# Session B install rules (B-0 plan section 2.2, owner conditions 17 Nov 2026). No secrets here.
registry=https://registry.npmjs.org/
ignore-scripts=true
save-exact=true
save-prefix=
audit=false
fund=false
update-notifier=false
engine-strict=true
# Minimum age 14 days: newest allowed publish date (17 Nov 2026 minus 14 days). Applies to transitive packages too.
before=2026-11-03T00:00:00.000Z
