{
  "name": "ecohomely-dashboard-functions",
  "version": "1.0.0",
  "description": "Firebase Functions for Ecohomely dashboard admin operations.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "deploy:storage-cleanup": "firebase deploy --only functions:cleanupUnusedStorageFiles",
    "logs:storage-cleanup": "firebase functions:log --only cleanupUnusedStorageFiles"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0"
  }
}
